<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 ships with Windows 10/11, so the installer needs no runtime of its own. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>SonosFlow-Setup</AssemblyName>
    <RootNamespace>SonosFlow.Setup</RootNamespace>
    <ApplicationIcon>..\SonosFlow.App\Assets\SonosFlow.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Sonos Flow</Product>
    <PayloadZip Condition="'$(PayloadZip)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\payload.zip</PayloadZip>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(PayloadZip)')">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
  </ItemGroup>

</Project>
