<Project Sdk="Microsoft.NET.Sdk">

  <!-- .NET Framework 4.8 ships with Windows 10/11, so the installer needs no runtime of its own. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>SonosFlow-Setup</AssemblyName>
    <RootNamespace>SonosFlow.Setup</RootNamespace>
    <ApplicationIcon>..\SonosFlow.App\Assets\SonosFlow.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Same SemVer as the app and the GitHub release tag; DisplayVersion uses the numeric part (1.0.0). -->
    <Version>1.0.0-beta.2</Version>
    <Product>Audiora</Product>
    <AssemblyTitle>Instalar Audiora</AssemblyTitle>
    <PayloadZip Condition="'$(PayloadZip)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\payload.zip</PayloadZip>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Installer text: the setup.json area of the app's translations (no comments allowed in these files). -->
    <EmbeddedResource Include="..\SonosFlow.App\Localization\Strings\**\setup.json" LogicalName="i18n/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(PayloadZip)')">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
  </ItemGroup>

</Project>
