<Application x:Class="SonosFlow.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:SonosFlow.App.Infrastructure"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <infra:BoolToVisibilityConverter x:Key="BoolToVis" />
            <infra:BoolToVisibilityConverter x:Key="BoolToVisInv" Invert="True" />
            <infra:DbfsToTextConverter x:Key="DbfsText" />
            <infra:InvertBoolConverter x:Key="InvertBool" />
            <infra:ZeroToVisibilityConverter x:Key="ZeroToVis" />
            <infra:LevelToOpacityConverter x:Key="LevelGlow" Min="0.25" Max="1" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
