<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ctl="clr-namespace:SonosFlow.App.Controls">

    <!-- Palette: near-black, charcoal, restrained emerald. Green only means "live" or the primary action. -->
    <Color x:Key="C.Bg0">#FF060708</Color>
    <Color x:Key="C.Bg1">#FF0B0D0F</Color>
    <Color x:Key="C.Card">#FF0F1214</Color>
    <Color x:Key="C.CardHi">#FF15191C</Color>
    <Color x:Key="C.CardPress">#FF1B2024</Color>
    <Color x:Key="C.Stroke">#FF1A1F23</Color>
    <Color x:Key="C.StrokeHi">#FF272E33</Color>
    <Color x:Key="C.Text">#FFF2F4F5</Color>
    <Color x:Key="C.TextDim">#FF8E979E</Color>
    <!-- 4.7:1 on the surfaces (was #59636A, 3:1: below WCAG AA for small text) -->
    <Color x:Key="C.TextFaint">#FF78838B</Color>
    <Color x:Key="C.Accent">#FF2FD27A</Color>
    <Color x:Key="C.AccentHi">#FF52E596</Color>
    <Color x:Key="C.AccentDeep">#FF14985A</Color>
    <Color x:Key="C.Warn">#FFF2B544</Color>
    <Color x:Key="C.Danger">#FFFF6461</Color>

    <SolidColorBrush x:Key="B.Bg0" Color="{StaticResource C.Bg0}" />
    <SolidColorBrush x:Key="B.Bg1" Color="{StaticResource C.Bg1}" />
    <SolidColorBrush x:Key="B.Card" Color="{StaticResource C.Card}" />
    <SolidColorBrush x:Key="B.CardHi" Color="{StaticResource C.CardHi}" />
    <SolidColorBrush x:Key="B.Stroke" Color="{StaticResource C.Stroke}" />
    <SolidColorBrush x:Key="B.StrokeHi" Color="{StaticResource C.StrokeHi}" />
    <SolidColorBrush x:Key="B.Text" Color="{StaticResource C.Text}" />
    <SolidColorBrush x:Key="B.TextDim" Color="{StaticResource C.TextDim}" />
    <SolidColorBrush x:Key="B.TextFaint" Color="{StaticResource C.TextFaint}" />
    <SolidColorBrush x:Key="B.Accent" Color="{StaticResource C.Accent}" />
    <SolidColorBrush x:Key="B.AccentHi" Color="{StaticResource C.AccentHi}" />
    <SolidColorBrush x:Key="B.Warn" Color="{StaticResource C.Warn}" />
    <SolidColorBrush x:Key="B.Danger" Color="{StaticResource C.Danger}" />
    <SolidColorBrush x:Key="B.AccentSoft" Color="#1F2FD27A" />
    <SolidColorBrush x:Key="B.Glass" Color="#0BFFFFFF" />
    <SolidColorBrush x:Key="B.GlassHi" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="B.CardPress" Color="{StaticResource C.CardPress}" />
    <SolidColorBrush x:Key="B.Hairline" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="B.OnAccent" Color="#FF03130A" />
    <SolidColorBrush x:Key="B.WarnSoft" Color="#1FF2B544" />
    <SolidColorBrush x:Key="B.DangerSoft" Color="#1FFF6461" />

    <LinearGradientBrush x:Key="B.AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF5BF0A0" Offset="0" />
        <GradientStop Color="#FF22C06A" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="B.CardGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF141A1E" Offset="0" />
        <GradientStop Color="#FF0F1316" Offset="1" />
    </LinearGradientBrush>

    <!-- ══════════ Liquid glass: translucent panels over the aurora, lit from the top-left ══════════ -->
    <LinearGradientBrush x:Key="B.Panel" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#26FFFFFF" Offset="0" />
        <GradientStop Color="#0FFFFFFF" Offset="0.45" />
        <GradientStop Color="#0C34E58E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.PanelEdge" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#5CFFFFFF" Offset="0" />
        <GradientStop Color="#16FFFFFF" Offset="0.4" />
        <GradientStop Color="#142FD27A" Offset="0.75" />
        <GradientStop Color="#4034E58E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="B.Sheet" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF123628" Offset="0" />
        <GradientStop Color="#FF08170F" Offset="0.5" />
        <GradientStop Color="#FF040D09" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="B.PanelDeep" Color="#47020A07" />
    <SolidColorBrush x:Key="B.SideSheet" Color="#2E04140E" />
    <DropShadowEffect x:Key="Fx.Glass" BlurRadius="34" ShadowDepth="10" Direction="270" Opacity="0.5" Color="#000000" />

    <FontFamily x:Key="F.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="F.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <DropShadowEffect x:Key="Fx.Card" BlurRadius="28" ShadowDepth="6" Direction="270" Opacity="0.45" Color="#000000" />
    <DropShadowEffect x:Key="Fx.AccentGlow" BlurRadius="34" ShadowDepth="0" Opacity="0.55" Color="#31D67B" />

    <!-- Text -->
    <Style x:Key="T.Base" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Text}" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>
    <Style x:Key="T.Title" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="T.Section" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="T.Dim" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
    </Style>
    <Style x:Key="T.Caps" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="Foreground" Value="{StaticResource B.TextFaint}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="T.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource F.Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Cards -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.PanelEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Effect" Value="{StaticResource Fx.Glass}" />
    </Style>
    <Style x:Key="InnerCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Glass}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- Focus ring shared by controls (keyboard accessibility) -->
    <Style x:Key="FocusRing">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" RadiusX="12" RadiusY="12" Stroke="{StaticResource B.Accent}" StrokeThickness="1.5" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Buttons -->
    <Style x:Key="Btn.Ghost" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Background" Value="{StaticResource B.Glass}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.Stroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="FontFamily" Value="{StaticResource F.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border ctl:Motion.Press="True" x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.GlassHi}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.StrokeHi}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Btn.Accent" TargetType="Button" BasedOn="{StaticResource Btn.Ghost}">
        <Setter Property="Background" Value="{StaticResource B.AccentGradient}" />
        <Setter Property="Foreground" Value="#FF04140A" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Window caption buttons (Windows layout, right side) -->
    <Style x:Key="Btn.Caption" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontFamily" Value="{StaticResource F.Icons}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.GlassHi}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Btn.CaptionClose" TargetType="Button" BasedOn="{StaticResource Btn.Caption}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#FFC42B1C" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar navigation (RadioButton = one selected) -->
    <Style x:Key="Nav" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Text}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,9" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Glass}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.GlassHi}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Stroke}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- iOS/macOS-style switch -->
    <Style x:Key="Switch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Border x:Name="Track" Width="40" Height="24" CornerRadius="12" Background="#FF2A3238" />
                        <Ellipse ctl:Motion.OffsetX="-8" x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Center" Margin="0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform x:Name="KnobX" X="-8" />
                            </Ellipse.RenderTransform>
                            <Ellipse.Effect>
                                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35" />
                            </Ellipse.Effect>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource B.Accent}" />
                            <Setter TargetName="Knob" Property="ctl:Motion.OffsetX" Value="8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider: thin track, emerald fill, white thumb -->
    <Style x:Key="SliderRepeat" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderThumb" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Ellipse x:Name="E" Width="16" Height="16" Fill="White" RenderTransformOrigin="0.5,0.5">
                        <Ellipse.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.45" /></Ellipse.Effect>
                    </Ellipse>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="E" Property="RenderTransform">
                                <Setter.Value><ScaleTransform ScaleX="1.15" ScaleY="1.15" /></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Slider.Flow" TargetType="Slider">
        <Setter Property="Height" Value="22" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="4" CornerRadius="2" Background="#FF2A3238" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderRepeat}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" CornerRadius="2" Background="{StaticResource B.AccentGradient}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRepeat}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ComboBox (dark, rounded) -->
    <Style x:Key="ComboToggle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{StaticResource B.Glass}" BorderBrush="{StaticResource B.Stroke}" BorderThickness="1" CornerRadius="10">
                        <TextBlock Text="&#xE70D;" Style="{StaticResource T.Icon}" FontSize="10" Foreground="{StaticResource B.TextDim}"
                                   HorizontalAlignment="Right" Margin="0,0,12,0" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.StrokeHi}" />
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.GlassHi}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Combo.Flow" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource ComboToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter Margin="14,0,34,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          TextBlock.Foreground="{StaticResource B.Text}" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="None" Focusable="False">
                            <Border ctl:Motion.Enter="True" Background="#FF151B1F" BorderBrush="{StaticResource B.StrokeHi}" BorderThickness="1" CornerRadius="10" Margin="0,4,0,0"
                                    MinWidth="{TemplateBinding ActualWidth}" Padding="4">
                                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="Bd" CornerRadius="7" Padding="10,8" Background="Transparent">
                                    <ContentPresenter />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.GlassHi}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.AccentSoft}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Minimal scrollbars -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6" />
        <Setter Property="MinWidth" Value="6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="3" Background="#33FFFFFF" />
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented choice: neutral raised pill for the selected option (green stays reserved for "live") -->
    <Style x:Key="Seg" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Text}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="15" Padding="16,6" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3D2FD27A" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#552FD27A" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SegTrack" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.PanelDeep}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.PanelEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="3" />
    </Style>

    <!-- Row button for lists of applications -->
    <ControlTemplate x:Key="AppRowButton" TargetType="Button">
        <Border x:Name="Bd" CornerRadius="8" Padding="8,6" Background="Transparent">
            <ContentPresenter />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Glass}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.AccentSoft}" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Green when the bound item IsActive -->
    <Style x:Key="ActiveDot" TargetType="Ellipse">
        <Setter Property="Fill" Value="{StaticResource B.TextFaint}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsActive}" Value="True">
                <Setter Property="Fill" Value="{StaticResource B.Accent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ══════════ Premium redesign: typography, surfaces and quiet controls ══════════ -->

    <Style x:Key="T.Hero" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="FontSize" Value="44" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="T.Kicker" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="Foreground" Value="{StaticResource B.TextFaint}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="T.Value" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
        <Setter Property="FontFamily" Value="{StaticResource F.Display}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Grouped list surface (settings, flyouts): one quiet surface instead of stacked cards -->
    <Style x:Key="Surface.Group" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource B.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.PanelEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="18,6" />
    </Style>
    <Style x:Key="Hairline" TargetType="Rectangle">
        <Setter Property="Height" Value="1" />
        <Setter Property="Fill" Value="{StaticResource B.Hairline}" />
    </Style>
    <Style x:Key="Flyout" TargetType="Border">
        <Setter Property="ctl:Motion.Enter" Value="True" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F51B2A25" Offset="0" />
                    <GradientStop Color="#F50A1411" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="{StaticResource B.PanelEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="12" />
        <Setter Property="Effect">
            <Setter.Value><DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.55" Color="#000000" /></Setter.Value>
        </Setter>
    </Style>

    <!-- Pill button (secondary actions) -->
    <Style x:Key="Btn.Pill" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="Background" Value="{StaticResource B.Panel}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.PanelEdge}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="FontFamily" Value="{StaticResource F.Text}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border ctl:Motion.Press="True" x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="17" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.GlassHi}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.CardPress}" />
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.GlassHi}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.StrokeHi}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text-only button (tertiary actions, footer) -->
    <Style x:Key="Btn.Quiet" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontFamily" Value="{StaticResource F.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border ctl:Motion.Press="True" x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Glass}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.GlassHi}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header tabs: text with a short emerald underline when selected -->
    <Style x:Key="Nav.Tab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Text}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent" Margin="2,0">
                        <ContentPresenter Margin="10,8" VerticalAlignment="Center" />
                        <Border x:Name="Bar" Height="2" Width="18" CornerRadius="1" VerticalAlignment="Bottom" Margin="0,0,0,4"
                                Background="{StaticResource B.Accent}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Sidebar entry: glyph + label; selected = lit glass pill, green glyph -->
    <Style x:Key="Nav.Side" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Text}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,3" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="13" Padding="14,10" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="{StaticResource F.Icons}" FontSize="16"
                                       Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center" FlowDirection="LeftToRight" />
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Glass}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Panel}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.PanelEdge}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{StaticResource B.AccentHi}" />
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Source chip (applications): neutral; selected = soft emerald outline -->
    <ControlTemplate x:Key="ChipButton" TargetType="Button">
        <Border x:Name="Bd" CornerRadius="18" Padding="10,7,14,7" Background="{StaticResource B.Panel}"
                BorderBrush="{StaticResource B.PanelEdge}" BorderThickness="1">
            <ContentPresenter VerticalAlignment="Center" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.GlassHi}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.CardPress}" />
            </Trigger>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.AccentSoft}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="#662FD27A" />
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Volume slider: wider track, solid emerald fill, thumb grows on hover -->
    <Style x:Key="Slider.Volume" TargetType="Slider" BasedOn="{StaticResource Slider.Flow}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border Height="6" CornerRadius="3" Background="#1CFFFFFF" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderRepeat}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="6" CornerRadius="3" Background="{StaticResource B.Accent}" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRepeat}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status dot driven by the session state -->
    <Style x:Key="StateDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Fill" Value="{StaticResource B.TextFaint}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Streaming">
                <Setter Property="Fill" Value="{StaticResource B.Accent}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Recovering">
                <Setter Property="Fill" Value="{StaticResource B.Warn}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Error">
                <Setter Property="Fill" Value="{StaticResource B.Danger}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Starting">
                <Setter Property="Fill" Value="{StaticResource B.TextDim}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding State}" Value="Streaming" />
                    <Condition Binding="{Binding IsPaused}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Fill" Value="{StaticResource B.Text}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#FF1A2126" />
        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
        <Setter Property="BorderBrush" Value="{StaticResource B.StrokeHi}" />
        <Setter Property="FontFamily" Value="{StaticResource F.Text}" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
</ResourceDictionary>
