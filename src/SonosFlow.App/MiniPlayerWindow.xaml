<Window x:Class="SonosFlow.App.MiniPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SonosFlow.App.ViewModels"
        xmlns:ctl="clr-namespace:SonosFlow.App.Controls"
        xmlns:loc="clr-namespace:SonosFlow.App.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{loc:T mini.window.title}"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False"
        SizeToContent="WidthAndHeight" Topmost="{Binding MiniTopmost}"
        FontFamily="{StaticResource F.Text}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}">

    <Window.Resources>
        <!-- Deep emerald glass: solid enough to read over any game or desktop, no blur needed -->
        <LinearGradientBrush x:Key="Glass" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F2141E48" Offset="0" />
            <GradientStop Color="#F50C1332" Offset="0.55" />
            <GradientStop Color="#F70A1030" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="Edge" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#66FFFFFF" Offset="0" />
            <GradientStop Color="#1AFFFFFF" Offset="0.45" />
            <GradientStop Color="#55B6A5FF" Offset="1" />
        </LinearGradientBrush>

        <!-- Speaker status dot: emerald while live, grey otherwise -->
        <Style x:Key="SpeakerDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{StaticResource B.TextFaint}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SpeakerOnline}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource B.TextDim}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource B.Accent}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconBtn" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource B.TextDim}" />
            <Setter Property="FontFamily" Value="{StaticResource F.Icons}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="17" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2BFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Margin leaves room for the soft shadow inside the transparent window. -->
    <StackPanel x:Name="Root" Margin="22">
        <Border x:Name="Capsule" Width="600" Height="76" CornerRadius="38" Background="{StaticResource Glass}"
                BorderBrush="{StaticResource Edge}" BorderThickness="1" MouseLeftButtonDown="Capsule_MouseLeftButtonDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="26" ShadowDepth="6" Direction="270" Opacity="0.6" Color="#000000" />
            </Border.Effect>
            <Grid Margin="12,0,14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Artwork (when Windows publishes it) inside the live level ring -->
                <Grid Width="56" Height="56" VerticalAlignment="Center">
                    <ctl:LevelRing x:Name="Ring" IsLive="{Binding IsActive}" />
                    <Ellipse Width="44" Height="44" Fill="{StaticResource B.CardHi}" />
                    <TextBlock Text="&#xEC4F;" FontFamily="{StaticResource F.Icons}" FontSize="17" Foreground="{StaticResource B.TextDim}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Ellipse Width="44" Height="44" FlowDirection="LeftToRight" Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVis}}">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding NowPlayingArtwork}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>

                <!-- Title (or source), then status · speaker -->
                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center" ToolTip="{Binding NowPlayingText}">
                    <TextBlock FontSize="14" FontWeight="SemiBold" FontFamily="{StaticResource F.Display}" Foreground="{StaticResource B.Text}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" FlowDirection="{Binding Text, RelativeSource={RelativeSource Self}, Converter={x:Static loc:AutoDirection.Instance}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding SourceName}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNowPlaying}" Value="True">
                                        <Setter Property="Text" Value="{Binding NowPlayingTitle}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse Style="{StaticResource SpeakerDot}" />
                        <TextBlock Text="{Binding MiniStatusText}" Foreground="{StaticResource B.TextDim}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                        <TextBlock Foreground="{StaticResource B.TextDim}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="80"
                                   Visibility="{Binding HasSpeaker, Converter={StaticResource BoolToVis}}">
                            <Run Text=" · " /><Run Text="{Binding SelectedSpeaker.Name, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <!-- Sonos volume (same value as the main window) -->
                <Grid Grid.Column="2" VerticalAlignment="Center" Margin="4,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource F.Icons}" FontSize="13" Foreground="{StaticResource B.TextDim}" VerticalAlignment="Center" FlowDirection="LeftToRight" />
                    <Slider Grid.Column="1" Style="{StaticResource Slider.Flow}" Minimum="0" Maximum="100" Margin="9,0,8,0" Focusable="False"
                            Value="{Binding Volume, Mode=TwoWay}" IsEnabled="{Binding ControlsReady}" AutomationProperties.Name="{loc:T mini.volume.name}" />
                    <TextBlock Grid.Column="2" FontSize="12.5" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding Volume}" />
                                <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ControlsReady}" Value="False">
                                        <Setter Property="Text" Value="—" />
                                        <Setter Property="Foreground" Value="{StaticResource B.TextFaint}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <!-- Pause / resume (starts streaming when stopped) -->
                <Button Grid.Column="3" Width="46" Height="46" Margin="8,0,8,0" Cursor="Hand" Focusable="False" FlowDirection="LeftToRight"
                        Command="{Binding PauseResumeCommand}" AutomationProperties.Name="{loc:T mini.pause.name}">
                    <Button.ToolTip>
                        <ToolTip>
                            <TextBlock Text="{loc:T mini.pause.tooltip}" />
                        </ToolTip>
                    </Button.ToolTip>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="G" RenderTransformOrigin="0.5,0.5">
                                <Ellipse>
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{StaticResource B.AccentGradient}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Fill" Value="#FFF5F7FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="G" Property="RenderTransform">
                                        <Setter.Value><ScaleTransform ScaleX="1.05" ScaleY="1.05" /></Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="G" Property="Opacity" Value="0.35" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <TextBlock FontFamily="{StaticResource F.Icons}" FontSize="17" Foreground="{StaticResource B.OnAccent}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="&#xE768;" />
                                <Setter Property="Margin" Value="2,0,0,0" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsStreaming}" Value="True" />
                                            <Condition Binding="{Binding IsPaused}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Text" Value="&#xE769;" />
                                        <Setter Property="Margin" Value="0" />
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>

                <Button Grid.Column="4" Command="{Binding ToggleMiniSourcesCommand}" ToolTip="{loc:T mini.sources.toggle}"
                        AutomationProperties.Name="{loc:T mini.sources.toggle}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource IconBtn}">
                            <Setter Property="Content" Value="&#xE70E;" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MiniSourcesExpanded}" Value="True">
                                    <Setter Property="Content" Value="&#xE70D;" />
                                    <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="5" Style="{StaticResource IconBtn}" Content="&#xE8A7;" Command="{Binding ShowMainCommand}"
                        ToolTip="{loc:T mini.showMain}" AutomationProperties.Name="{loc:T mini.showMain}" />
                <Button Grid.Column="6" Style="{StaticResource IconBtn}" Content="&#xE711;" Click="Hide_Click"
                        ToolTip="{loc:T mini.hide.tooltip}" AutomationProperties.Name="{loc:T mini.hide.name}" />
            </Grid>
        </Border>

        <!-- Source picker (same state as the main window) -->
        <Border Margin="60,8,60,0" CornerRadius="18" Background="{StaticResource Glass}" BorderBrush="{StaticResource Edge}" BorderThickness="1"
                Padding="8" Visibility="{Binding MiniSourcesExpanded, Converter={StaticResource BoolToVis}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Opacity="0.55" Color="#000000" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="{loc:T mini.sources.title}" Style="{StaticResource T.Kicker}" Margin="10,4,0,6" />
                <Button Command="{Binding UseSystemCommand}" Template="{StaticResource AppRowButton}" Cursor="Hand" Focusable="False">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource F.Icons}" FontSize="15" Foreground="{StaticResource B.TextDim}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{loc:T mini.sources.system}" Style="{StaticResource T.Base}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </Button>
                <ItemsControl ItemsSource="{Binding Apps}" MaxHeight="200">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False"><ItemsPresenter /></ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AppSourceItem}">
                            <Button Command="{Binding DataContext.SelectAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                    Template="{StaticResource AppRowButton}" Cursor="Hand" Focusable="False">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding Icon}" Width="18" Height="18" HorizontalAlignment="Left" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource T.Base}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding StateText}" Style="{StaticResource T.Dim}" FontSize="11" VerticalAlignment="Center" Margin="8,0,4,0" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</Window>
