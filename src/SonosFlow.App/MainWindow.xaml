<Window x:Class="SonosFlow.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:SonosFlow.App.ViewModels"
        xmlns:ctl="clr-namespace:SonosFlow.App.Controls"
        xmlns:views="clr-namespace:SonosFlow.App.Views"
        xmlns:loc="clr-namespace:SonosFlow.App.Localization"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="{loc:T main.window.title}" Width="1280" Height="840" MinWidth="1080" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource B.Bg0}"
        Foreground="{StaticResource B.Text}"
        FontFamily="{StaticResource F.Text}"
        TextOptions.TextFormattingMode="Ideal"
        UseLayoutRounding="True"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Speaker entry in the device menu -->
        <DataTemplate x:Key="SpeakerTemplate" DataType="{x:Type vm:SpeakerItem}">
            <Button Command="{Binding DataContext.SelectSpeakerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    CommandParameter="{Binding}" Click="Speaker_Click" Cursor="Hand" Margin="0,1" FocusVisualStyle="{StaticResource FocusRing}"
                    AutomationProperties.Name="{Binding Name}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="11" Padding="10,9" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Glass}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.GlassHi}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Width="32" Height="32" CornerRadius="9" Background="{StaticResource B.GlassHi}" HorizontalAlignment="Left">
                        <TextBlock Text="&#xE7F5;" Style="{StaticResource T.Icon}" FontSize="14" HorizontalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource T.Dim}" FontSize="11.5" TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding Model, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Address, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <Ellipse Grid.Column="2" Width="8" Height="8" Margin="8,0,2,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource B.TextFaint}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsOnline}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource B.TextDim}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource B.Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Footer readout: label + value -->
        <Style x:Key="FootLabel" TargetType="TextBlock" BasedOn="{StaticResource T.Dim}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="FootValue" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="5,0,0,0" />
        </Style>
        <Style x:Key="DetailKey" TargetType="TextBlock" BasedOn="{StaticResource T.Dim}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style x:Key="DetailValue" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="12,4,0,4" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═══════════ Header (drag area via WindowChrome) ═══════════ -->
        <Grid Margin="22,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/Assets/SonosFlow.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{loc:T main.header.brand}" Style="{StaticResource T.Base}" FontFamily="{StaticResource F.Display}" FontSize="15" FontWeight="SemiBold" Margin="9,0,0,1" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="30,0,0,0" VerticalAlignment="Center">
                <RadioButton x:Name="NavHome" Style="{StaticResource Nav.Tab}" GroupName="nav" IsChecked="True" Content="{loc:T main.nav.home}"
                             Command="{Binding NavigateCommand}" CommandParameter="home" />
                <RadioButton x:Name="NavSettings" Style="{StaticResource Nav.Tab}" GroupName="nav" Content="{loc:T main.nav.settings}"
                             Command="{Binding NavigateCommand}" CommandParameter="settings" />
            </StackPanel>

            <!-- Device selector -->
            <ToggleButton x:Name="DeviceToggle" Grid.Column="3" Style="{StaticResource Btn.Pill}" Padding="12,6,12,6" VerticalAlignment="Center"
                          IsHitTestVisible="{Binding IsOpen, ElementName=DevicePopup, Converter={StaticResource InvertBool}}"
                          Margin="0,0,10,0" AutomationProperties.Name="{loc:T main.header.speakerPicker.name}" ToolTip="{loc:T main.header.speakerPicker.tooltip}">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Margin="0,0,9,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource B.TextFaint}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SpeakerOnline}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource B.TextDim}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource B.Accent}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="&#xE7F5;" Style="{StaticResource T.Icon}" FontSize="13" Margin="0,0,7,0" />
                    <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding SelectedSpeaker.Name}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedSpeaker, FallbackValue={x:Null}}" Value="{x:Null}">
                                        <Setter Property="Text" Value="{loc:T main.header.speakerPicker.empty}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="&#xE70D;" Style="{StaticResource T.Icon}" FontSize="9" Foreground="{StaticResource B.TextDim}" Margin="9,1,0,0" />
                </StackPanel>
            </ToggleButton>
            <Popup x:Name="DevicePopup" Grid.Column="3" PlacementTarget="{Binding ElementName=DeviceToggle}" Placement="Bottom" HorizontalOffset="-180"
                   IsOpen="{Binding IsChecked, ElementName=DeviceToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Style="{StaticResource Flyout}" Width="330" Padding="10">
                    <StackPanel>
                        <TextBlock Text="{loc:T main.speakers.title}" Style="{StaticResource T.Kicker}" Margin="10,4,0,8" />
                        <ItemsControl ItemsSource="{Binding Speakers}" ItemTemplate="{StaticResource SpeakerTemplate}" />
                        <TextBlock Text="{loc:T main.speakers.empty}" Margin="10,6" FontSize="12" TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource T.Dim}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Speakers.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Rectangle Style="{StaticResource Hairline}" Margin="6,8" />
                        <Button Command="{Binding RescanCommand}" Style="{StaticResource Btn.Quiet}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" Style="{StaticResource T.Icon}" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock Text="{loc:T main.speakers.rescan}" Margin="9,0,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Popup>

            <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Style="{StaticResource Btn.Caption}" Height="40" Content="&#xE8A7;" Command="{Binding ToggleMiniCommand}" ToolTip="{loc:T main.caption.mini.tooltip}"
                        AutomationProperties.Name="{loc:T main.caption.mini.name}" />
                <Button Style="{StaticResource Btn.Caption}" Height="40" Content="&#xE921;" Click="Minimize_Click" ToolTip="{loc:T main.caption.minimize}" AutomationProperties.Name="{loc:T main.caption.minimize}" />
                <Button x:Name="MaxButton" Style="{StaticResource Btn.Caption}" Height="40" Content="&#xE922;" Click="Maximize_Click" ToolTip="{loc:T main.caption.maximize}" AutomationProperties.Name="{loc:T main.caption.maximize}" />
                <Button Style="{StaticResource Btn.CaptionClose}" Height="40" Content="&#xE8BB;" Click="Close_Click" ToolTip="{loc:T main.caption.close}" AutomationProperties.Name="{loc:T main.caption.close}" />
            </StackPanel>
        </Grid>

        <!-- ═══════════ Pages ═══════════ -->
        <Grid Grid.Row="1" x:Name="PageHost">
            <ScrollViewer x:Name="HomePage" VerticalScrollBarVisibility="Auto">
                <Grid MaxWidth="760" Margin="32,0,32,20" HorizontalAlignment="Center" Width="760">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Error: what happened and what to do -->
                    <Border CornerRadius="14" Padding="16,12" Margin="0,4,0,8" Background="{StaticResource B.DangerSoft}" BorderBrush="#66FF6461" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="Error">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource T.Icon}" Foreground="{StaticResource B.Danger}" VerticalAlignment="Top" Margin="0,2,12,0" />
                            <TextBlock Grid.Column="1" Text="{Binding StatusDetail}" Style="{StaticResource T.Base}" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Content="{loc:T main.error.rescan}" Command="{Binding RescanCommand}" Style="{StaticResource Btn.Quiet}" Margin="0,0,6,0" />
                                <Button Content="{loc:T main.error.retry}" Command="{Binding ToggleStreamCommand}" Style="{StaticResource Btn.Pill}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Device and state -->
                    <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,2,0,0">
                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource T.Dim}" FontSize="12.5"
                                   Visibility="{Binding HasSpeaker, Converter={StaticResource BoolToVis}}">
                            <Run Text="{Binding SelectedSpeaker.Model, Mode=OneWay, FallbackValue='Sonos'}" /><Run Text="  ·  " /><Run Text="{Binding ConnectionText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock HorizontalAlignment="Center" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource T.Hero}">
                                    <Setter Property="Text" Value="{Binding SelectedSpeaker.Name}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedSpeaker, FallbackValue={x:Null}}" Value="{x:Null}">
                                            <Setter Property="Text" Value="{loc:T main.speaker.none}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Ellipse Style="{StaticResource StateDot}" VerticalAlignment="Center" Margin="0,1,8,0" />
                            <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource T.Base}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusDetail}" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="520" Margin="0,4,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource T.Dim}">
                                    <Style.Triggers>
                                        <!-- In error the banner above already shows it -->
                                        <DataTrigger Binding="{Binding State}" Value="Error">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <!-- Secondary problems (e.g. no browser for YouTube Music, a setting the Sonos rejected) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0" MaxWidth="560">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLastError}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding State}" Value="Error">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE7BA;" Style="{StaticResource T.Icon}" FontSize="12" Foreground="{StaticResource B.Warn}" Margin="0,1,7,0" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding LastErrorText}" Style="{StaticResource T.Base}" Foreground="{StaticResource B.Warn}" FontSize="12.5" TextWrapping="Wrap" MaxWidth="530" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Stage: real spectrum ring around the stream button -->
                    <Grid Grid.Row="2" Width="264" Height="264" Margin="0,6,0,0" HorizontalAlignment="Center" Background="Transparent"
                          ToolTip="{loc:T main.stage.tooltip}">

                        <Ellipse Width="264" Height="264" IsHitTestVisible="False" Opacity="{Binding Level, ElementName=Viz}">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#382FD27A" Offset="0" />
                                    <GradientStop Color="#102FD27A" Offset="0.55" />
                                    <GradientStop Color="#002FD27A" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <ctl:RadialSpectrum x:Name="Viz" Analyzer="{Binding Analyzer}" IsHitTestVisible="False" />
                        <Button x:Name="StreamButton" Width="104" Height="104" Command="{Binding ToggleStreamCommand}" Cursor="Hand" FlowDirection="LeftToRight"
                                FocusVisualStyle="{StaticResource FocusRing}" AutomationProperties.Name="{Binding StreamButtonText}"
                                ToolTip="{Binding StreamButtonText}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                                        <Ellipse x:Name="Disc">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource B.AccentGradient}" />
                                                    <Setter Property="Effect">
                                                        <Setter.Value><DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.45" Color="#2FD27A" /></Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <!-- Live: quiet dark disc with a fine emerald edge; the ring carries the energy -->
                                                        <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                                            <Setter Property="Fill" Value="{StaticResource B.CardHi}" />
                                                            <Setter Property="Stroke" Value="#802FD27A" />
                                                            <Setter Property="StrokeThickness" Value="1.5" />
                                                            <Setter Property="Effect" Value="{x:Null}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Recovering">
                                                            <Setter Property="Stroke" Value="{StaticResource B.Warn}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="RenderTransform">
                                                <Setter.Value><ScaleTransform ScaleX="1.03" ScaleY="1.03" /></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Root" Property="RenderTransform">
                                                <Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96" /></Setter.Value>
                                            </Setter>
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Root" Property="Opacity" Value="0.35" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <TextBlock FontFamily="{StaticResource F.Icons}" FontSize="30">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="&#xE768;" />
                                        <Setter Property="Margin" Value="5,0,0,0" />
                                        <Setter Property="Foreground" Value="{StaticResource B.OnAccent}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                                <Setter Property="Text" Value="&#xE71A;" />
                                                <Setter Property="Margin" Value="0" />
                                                <Setter Property="FontSize" Value="24" />
                                                <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding State}" Value="Recovering">
                                                <Setter Property="Foreground" Value="{StaticResource B.Warn}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </Grid>

                    <!-- Action label and time -->
                    <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,-6,0,14">
                        <TextBlock Text="{Binding StreamButtonText}" Style="{StaticResource T.Base}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource T.Dim}" FontSize="12" FontFamily="Cascadia Mono, Consolas" HorizontalAlignment="Center"
                                   Margin="0,3,0,0" Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <!-- Now playing (or the source when Windows publishes no title) + sleep timer -->
                    <Grid Grid.Row="4" Width="560" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="52" Height="52" CornerRadius="10" Background="{StaticResource B.CardHi}" ClipToBounds="True">
                            <Grid>
                                <TextBlock Text="&#xEC4F;" Style="{StaticResource T.Icon}" FontSize="20" Foreground="{StaticResource B.TextDim}" HorizontalAlignment="Center" />
                                <!-- A brush fills the slot exactly (an overflowing UniformToFill Image is mis-clipped in right-to-left) -->
                                <Border CornerRadius="10" FlowDirection="LeftToRight" RenderOptions.BitmapScalingMode="HighQuality"
                                        Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                                    <Border.Background><ImageBrush ImageSource="{Binding NowPlayingArtwork}" Stretch="UniformToFill" /></Border.Background>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center" ToolTip="{Binding NowPlayingText}">
                            <TextBlock FontSize="15" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" FlowDirection="{Binding Text, RelativeSource={RelativeSource Self}, Converter={x:Static loc:AutoDirection.Instance}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Value}">
                                        <Setter Property="Text" Value="{Binding SourceName}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNowPlaying}" Value="True">
                                                <Setter Property="Text" Value="{Binding NowPlayingTitle}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock FontSize="12.5" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Left" FlowDirection="{Binding Text, RelativeSource={RelativeSource Self}, Converter={x:Static loc:AutoDirection.Instance}}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Dim}">
                                        <Setter Property="Text" Value="{Binding SourceStatusText}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasNowPlaying}" Value="True">
                                                <Setter Property="Text" Value="{Binding NowPlayingArtist}" />
                                            </DataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding HasNowPlaying}" Value="True" />
                                                    <Condition Binding="{Binding NowPlayingArtist}" Value="{x:Null}" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Text" Value="{Binding SourceName}" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Visibility="{Binding IsStreaming, Converter={StaticResource BoolToVis}}">
                            <ComboBox Style="{StaticResource Combo.Flow}" Width="186" Height="34" FontSize="12" ItemsSource="{Binding SleepChoices}" SelectedValuePath="Key"
                                      SelectedValue="{Binding SleepKey}" AutomationProperties.Name="{loc:T main.sleep.name}"
                                      ToolTip="{loc:T main.sleep.tooltip}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="{Binding SleepRemainingText}" Style="{StaticResource T.Dim}" FontSize="11.5" HorizontalAlignment="Center" Margin="0,4,0,0"
                                       Visibility="{Binding SleepActive, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Grid>

                    <!-- Volume of the Sonos + local output options -->
                    <StackPanel Grid.Row="5" Width="560" Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="56" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE992;" Style="{StaticResource T.Icon}" FontSize="14" Foreground="{StaticResource B.TextDim}" FlowDirection="LeftToRight" />
                            <Slider Grid.Column="1" Style="{StaticResource Slider.Volume}" Minimum="0" Maximum="100" Margin="14,0"
                                    Value="{Binding Volume, Mode=TwoWay}" SmallChange="1" LargeChange="5"
                                    IsEnabled="{Binding ControlsReady}" AutomationProperties.Name="{loc:T main.volume.name}" ToolTip="{loc:T main.volume.name}" />
                            <TextBlock Grid.Column="2" Text="&#xE995;" Style="{StaticResource T.Icon}" FontSize="14" Foreground="{StaticResource B.TextDim}" FlowDirection="LeftToRight" />
                            <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="20" FontWeight="Normal">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource T.Value}">
                                        <Setter Property="Text" Value="{Binding Volume}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ControlsReady}" Value="False">
                                                <Setter Property="Text" Value="—" />
                                                <Setter Property="Foreground" Value="{StaticResource B.TextFaint}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MuteLocal}" IsEnabled="{Binding LocalOptionsEnabled}" AutomationProperties.Name="{loc:T main.muteLocal.label}"
                                      ToolTipService.ShowOnDisabled="True"
                                      ToolTip="{loc:T main.muteLocal.tooltip}" />
                            <TextBlock Text="{loc:T main.muteLocal.label}" Style="{StaticResource T.Dim}" FontSize="12.5" VerticalAlignment="Center" Margin="9,0,28,0" />
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding FullLevel}" IsEnabled="{Binding FullLevelEnabled}" AutomationProperties.Name="{loc:T main.fullLevel.label}"
                                      ToolTipService.ShowOnDisabled="True"
                                      ToolTip="{loc:T main.fullLevel.tooltip}" />
                            <TextBlock Text="{loc:T main.fullLevel.label}" Style="{StaticResource T.Dim}" FontSize="12.5" VerticalAlignment="Center" Margin="9,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Source -->
                    <StackPanel Grid.Row="6" HorizontalAlignment="Center">
                        <Border Style="{StaticResource SegTrack}" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource Seg}" Content="{loc:T main.source.mode.system.label}" GroupName="srcmode" IsChecked="{Binding IsAppMode, Converter={StaticResource InvertBool}, Mode=TwoWay}"
                                             AutomationProperties.Name="{loc:T main.source.mode.system.name}" />
                                <RadioButton Style="{StaticResource Seg}" Content="{loc:T main.source.mode.app.label}" GroupName="srcmode" IsChecked="{Binding IsAppMode, Mode=TwoWay}"
                                             AutomationProperties.Name="{loc:T main.source.mode.app.name}" />
                            </StackPanel>
                        </Border>

                        <!-- Whole PC: which output -->
                        <StackPanel Margin="0,14,0,0" Width="420" Visibility="{Binding IsAppMode, Converter={StaticResource BoolToVisInv}}">
                            <ComboBox x:Name="SourceCombo" Style="{StaticResource Combo.Flow}" ItemsSource="{Binding Outputs}" SelectedItem="{Binding SelectedOutput}"
                                      IsEnabled="{Binding CanEditOptions}" AutomationProperties.Name="{loc:T main.source.output.name}" />
                            <TextBlock Style="{StaticResource T.Dim}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0"
                                       Text="{loc:T main.source.output.hint}" />
                        </StackPanel>

                        <!-- One application: chips -->
                        <StackPanel Margin="0,14,0,0" Width="700" Visibility="{Binding IsAppMode, Converter={StaticResource BoolToVis}}">
                            <ItemsControl ItemsSource="{Binding Apps}" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:AppSourceItem}">
                                        <Button Command="{Binding DataContext.SelectAppCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                                Template="{StaticResource ChipButton}" Cursor="Hand" Margin="4" FocusVisualStyle="{StaticResource FocusRing}"
                                                AutomationProperties.Name="{Binding Name}" ToolTip="{Binding StateText}">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="{Binding Icon}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource T.Base}" FontSize="12.5" Margin="8,0,0,0" VerticalAlignment="Center"
                                                           MaxWidth="200" TextTrimming="CharacterEllipsis" />
                                                <Ellipse Width="6" Height="6" Margin="9,0,0,0" VerticalAlignment="Center" Style="{StaticResource ActiveDot}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{loc:T main.source.apps.empty}" Style="{StaticResource T.Dim}" FontSize="12" HorizontalAlignment="Center" Margin="0,4"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Visibility="{Binding Apps.Count, Converter={StaticResource ZeroToVis}}" />
                            <Button Command="{Binding LaunchYouTubeMusicCommand}" Style="{StaticResource Btn.Quiet}" HorizontalAlignment="Center" Margin="0,6,0,0"
                                    ToolTip="{loc:T main.source.ytMusic.tooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A7;" Style="{StaticResource T.Icon}" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="{loc:T main.source.ytMusic.label}" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ScrollViewer>

            <ScrollViewer x:Name="SettingsPage" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <views:SettingsView />
            </ScrollViewer>
        </Grid>

        <!-- ═══════════ Footer: connection status, Sonos sound, details ═══════════ -->
        <Border Grid.Row="2" BorderBrush="{StaticResource B.Hairline}" BorderThickness="0,1,0,0" Padding="22,0,14,0" Height="46">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,1,8,0" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource B.TextFaint}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource B.Accent}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding NetworkWarning}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource B.Warn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{loc:T main.footer.network.label}" Style="{StaticResource FootLabel}" ToolTip="{loc:T main.footer.network.tooltip}" />
                    <TextBlock Text="{Binding NetworkText}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource FootValue}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NetworkWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource B.Warn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{loc:T main.footer.buffer.label}" Style="{StaticResource FootLabel}" Margin="22,0,0,0" ToolTip="{loc:T main.footer.buffer.tooltip}" />
                    <TextBlock Text="{Binding BufferText}" Style="{StaticResource FootValue}" />
                    <TextBlock Text="{loc:T main.footer.rate.label}" Style="{StaticResource FootLabel}" Margin="22,0,0,0" />
                    <TextBlock Text="{Binding RateText}" Style="{StaticResource FootValue}" />
                    <TextBlock Text="{loc:T main.footer.transport.label}" Style="{StaticResource FootLabel}" Margin="22,0,0,0" />
                    <TextBlock Text="{Binding TransportText}" Style="{StaticResource FootValue}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ToggleButton x:Name="SoundToggle" Style="{StaticResource Btn.Quiet}" AutomationProperties.Name="{loc:T main.footer.sound.name}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=SoundPopup, Converter={StaticResource InvertBool}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9E9;" Style="{StaticResource T.Icon}" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            <TextBlock Text="{loc:T main.footer.sound.label}" Margin="7,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="DetailsToggle" Style="{StaticResource Btn.Quiet}" Margin="4,0,0,0" AutomationProperties.Name="{loc:T main.footer.details.name}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=DetailsPopup, Converter={StaticResource InvertBool}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE946;" Style="{StaticResource T.Icon}" FontSize="12" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                            <TextBlock Text="{loc:T main.footer.details.label}" Margin="7,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                </StackPanel>

                <!-- Sonos sound (EQ applied by the speaker itself) -->
                <Popup x:Name="SoundPopup" PlacementTarget="{Binding ElementName=SoundToggle}" Placement="Top" HorizontalOffset="-250"
                       IsOpen="{Binding IsChecked, ElementName=SoundToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Style="{StaticResource Flyout}" Width="340">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <TextBlock Text="{loc:T main.sound.title}" Style="{StaticResource T.Section}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,110,0" />
                                <Button Content="{loc:T main.sound.reset}" Command="{Binding ResetEqCommand}" Style="{StaticResource Btn.Quiet}" HorizontalAlignment="Right" IsEnabled="{Binding ControlsReady}" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:T main.sound.bass}" Style="{StaticResource T.Base}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Slider Grid.Column="1" Style="{StaticResource Slider.Flow}" Minimum="-10" Maximum="10" Value="{Binding Bass, Mode=TwoWay}"
                                        IsSnapToTickEnabled="True" TickFrequency="1" IsEnabled="{Binding ControlsReady}" AutomationProperties.Name="{loc:T main.sound.bass}" />
                                <TextBlock Grid.Column="2" Text="{Binding Bass, StringFormat={}{0:+0;-0;0}}" Style="{StaticResource T.Dim}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{loc:T main.sound.treble}" Style="{StaticResource T.Base}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Slider Grid.Column="1" Style="{StaticResource Slider.Flow}" Minimum="-10" Maximum="10" Value="{Binding Treble, Mode=TwoWay}"
                                        IsSnapToTickEnabled="True" TickFrequency="1" IsEnabled="{Binding ControlsReady}" AutomationProperties.Name="{loc:T main.sound.treble}" />
                                <TextBlock Grid.Column="2" Text="{Binding Treble, StringFormat={}{0:+0;-0;0}}" Style="{StaticResource T.Dim}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Grid>
                                <StackPanel Margin="0,0,52,0">
                                    <TextBlock Text="{loc:T main.sound.loudness}" Style="{StaticResource T.Base}" />
                                    <TextBlock Text="{loc:T main.sound.loudness.hint}" Style="{StaticResource T.Dim}" FontSize="11.5" TextWrapping="Wrap" />
                                </StackPanel>
                                <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding Loudness}"
                                          IsEnabled="{Binding ControlsReady}" AutomationProperties.Name="{loc:T main.sound.loudness}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Popup>

                <!-- Connection details -->
                <Popup x:Name="DetailsPopup" PlacementTarget="{Binding ElementName=DetailsToggle}" Placement="Top" HorizontalOffset="-330"
                       IsOpen="{Binding IsChecked, ElementName=DetailsToggle, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Style="{StaticResource Flyout}" Width="440">
                        <StackPanel>
                            <TextBlock Text="{loc:T main.details.title}" Style="{StaticResource T.Section}" Margin="0,0,0,10" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{loc:T main.details.speaker}" Style="{StaticResource DetailKey}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource DetailValue}">
                                    <Run Text="{Binding SelectedSpeaker.Name, Mode=OneWay, FallbackValue='—'}" /><Run Text=" · " /><Run Text="{Binding SelectedSpeaker.Address, Mode=OneWay, FallbackValue='—'}" />
                                </TextBlock>
                                <TextBlock Grid.Row="1" Text="{loc:T main.details.state}" Style="{StaticResource DetailKey}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConnectionText}" Style="{StaticResource DetailValue}" />
                                <TextBlock Grid.Row="2" Text="{loc:T main.details.stream}" Style="{StaticResource DetailKey}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding StreamUrl}" Style="{StaticResource DetailValue}" FontFamily="Cascadia Mono, Consolas" ToolTip="{Binding StreamUrl}" />
                                <TextBlock Grid.Row="3" Text="{loc:T main.details.format}" Style="{StaticResource DetailKey}" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FormatText}" Style="{StaticResource DetailValue}" />
                                <TextBlock Grid.Row="4" Text="{loc:T main.details.capture}" Style="{StaticResource DetailKey}" />
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SourceFormatText}" Style="{StaticResource DetailValue}" ToolTip="{Binding SourceFormatText}" />
                                <TextBlock Grid.Row="5" Text="{loc:T main.details.peak}" Style="{StaticResource DetailKey}" />
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PeakDbfs, ElementName=Viz, Converter={StaticResource DbfsText}}" Style="{StaticResource DetailValue}" />
                                <TextBlock Grid.Row="6" Text="{loc:T main.details.dropsReconnects}" Style="{StaticResource DetailKey}" />
                                <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource DetailValue}">
                                    <Run Text="{Binding DropsText, Mode=OneWay}" /><Run Text=" / " /><Run Text="{Binding ReconnectsText, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Grid.Row="7" Text="{loc:T main.details.lastError}" Style="{StaticResource DetailKey}" />
                                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding LastErrorText}" Style="{StaticResource DetailValue}" TextWrapping="Wrap" TextTrimming="None" />
                            </Grid>
                            <TextBlock Text="{loc:T main.details.note}"
                                       Style="{StaticResource T.Dim}" FontSize="11.5" TextWrapping="Wrap" Margin="0,10,0,0" />
                        </StackPanel>
                    </Border>
                </Popup>
            </Grid>
        </Border>
    </Grid>
</Window>
