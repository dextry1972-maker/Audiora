<Window x:Class="SonosFlow.App.Views.LanguageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SonosFlow.App.Localization"
        Title="Audiora" Width="520" Height="660" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource F.Text}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}">

    <Border Background="{StaticResource B.Sheet}" BorderBrush="{StaticResource B.PanelEdge}" BorderThickness="1" CornerRadius="24" Margin="14"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.6" Color="#000000" />
        </Border.Effect>
        <Grid Margin="32,26,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Style="{StaticResource Btn.Quiet}" Content="&#xE8BB;" FontFamily="{StaticResource F.Icons}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,-10,-16,0" Click="Close_Click" ToolTip="{loc:T onboarding.close.tooltip}" AutomationProperties.Name="{loc:T onboarding.close.tooltip}" IsTabStop="False" />

            <!-- Branding and welcome -->
            <StackPanel>
                <Image Source="/Assets/SonosFlow.png" Width="52" Height="52" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{loc:T onboarding.title}" Style="{StaticResource T.Title}" FontSize="28" Margin="0,18,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{loc:T onboarding.subtitle}" Style="{StaticResource T.Dim}" FontSize="13.5" TextWrapping="Wrap" Margin="0,8,0,0" LineHeight="20" />
            </StackPanel>

            <!-- Search -->
            <Grid Grid.Row="1" Margin="0,22,0,10">
                <TextBox x:Name="Search" Height="40" Padding="38,0,12,0" VerticalContentAlignment="Center" FontSize="13.5"
                         Background="{StaticResource B.Glass}" Foreground="{StaticResource B.Text}" CaretBrush="{StaticResource B.Text}"
                         BorderBrush="{StaticResource B.Stroke}" BorderThickness="1" TextChanged="Search_TextChanged" PreviewKeyDown="Search_PreviewKeyDown"
                         AutomationProperties.Name="{loc:T onboarding.search.label}">
                    <TextBox.Resources>
                        <Style TargetType="Border"><Setter Property="CornerRadius" Value="12" /></Style>
                    </TextBox.Resources>
                </TextBox>
                <TextBlock Text="&#xE721;" Style="{StaticResource T.Icon}" FontSize="14" Foreground="{StaticResource B.TextDim}" Margin="14,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchHint" Text="{loc:T onboarding.search.placeholder}" Style="{StaticResource T.Dim}" FontSize="13.5" Margin="39,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>

            <TextBlock Grid.Row="2" Text="{loc:T onboarding.list.label}" Style="{StaticResource T.Kicker}" Margin="4,0,0,6" />

            <!-- Languages -->
            <ListBox x:Name="List" Grid.Row="3" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="List_SelectionChanged" MouseDoubleClick="List_MouseDoubleClick" KeyDown="List_KeyDown"
                     AutomationProperties.Name="{loc:T onboarding.list.label}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding Display}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" CornerRadius="12" Padding="14,10" Margin="0,1" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Glass}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.AccentSoft}" />
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#66B6A5FF" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource B.Accent}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <!-- Native names keep their own direction whatever the window's -->
                                <TextBlock Text="{Binding Info.NativeName}" HorizontalAlignment="Left" FlowDirection="{Binding Text, RelativeSource={RelativeSource Self}, Converter={x:Static loc:AutoDirection.Instance}}" Style="{StaticResource T.Base}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Info.EnglishName}" HorizontalAlignment="Left" FlowDirection="{Binding Text, RelativeSource={RelativeSource Self}, Converter={x:Static loc:AutoDirection.Instance}}" Style="{StaticResource T.Dim}" FontSize="12" />
                            </StackPanel>
                            <Border Grid.Column="1" CornerRadius="9" Padding="8,3" Background="{StaticResource B.GlassHi}" VerticalAlignment="Center"
                                    Visibility="{Binding IsSuggested, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{loc:T onboarding.suggested}" Style="{StaticResource T.Base}" FontSize="11" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock x:Name="NoResults" Grid.Row="3" Text="{loc:T onboarding.search.noResults}" Style="{StaticResource T.Dim}" Margin="14,10" Visibility="Collapsed" />

            <!-- Confirm -->
            <Grid Grid.Row="4" Margin="0,18,0,0">
                <TextBlock Text="{loc:T onboarding.changeLater}" Style="{StaticResource T.Dim}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,170,0" />
                <Button x:Name="Confirm" Style="{StaticResource Btn.Accent}" HorizontalAlignment="Right" Padding="22,10" FontSize="13.5" Click="Confirm_Click"
                        IsDefault="True" AutomationProperties.Name="{loc:T onboarding.confirm}">
                    <TextBlock Text="{loc:T onboarding.confirm}" />
                </Button>
            </Grid>
        </Grid>
    </Border>
</Window>
