<UserControl x:Class="SonosFlow.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:SonosFlow.App.ViewModels"
             xmlns:loc="clr-namespace:SonosFlow.App.Localization"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance vm:MainViewModel}">

    <UserControl.Resources>
        <!-- One setting: title + description on the left, control on the right -->
        <Style x:Key="RowTitle" TargetType="TextBlock" BasedOn="{StaticResource T.Base}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock" BasedOn="{StaticResource T.Dim}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxWidth" Value="520" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,13" />
        </Style>
        <Style x:Key="Section" TargetType="TextBlock" BasedOn="{StaticResource T.Kicker}">
            <Setter Property="Margin" Value="18,26,0,10" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource T.Kicker}">
            <Setter Property="Foreground" Value="{StaticResource B.AccentHi}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Resources>

    <StackPanel MaxWidth="760" Margin="32,8,32,40">
        <TextBlock Text="{loc:T settings.title}" Style="{StaticResource T.Title}" Margin="2,0,0,0" />
        <TextBlock Text="{loc:T settings.subtitle}"
                   Style="{StaticResource T.Dim}" FontSize="12.5" TextWrapping="Wrap" Margin="2,6,0,0" />

        <!-- Category tabs (Aurora 2.0): one pane at a time instead of one long column -->
        <Border Margin="0,16,0,2" Padding="5" CornerRadius="16" HorizontalAlignment="Left" Background="{StaticResource B.PanelDeep}"
                BorderBrush="{StaticResource B.Hairline}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="TabProfile" Style="{StaticResource Tab.Pill}" GroupName="settingsTab" IsChecked="True" Tag="profile" Checked="Tab_Checked" Content="{loc:T settings.tab.profile}" />
                <RadioButton Style="{StaticResource Tab.Pill}" GroupName="settingsTab" Tag="general" Checked="Tab_Checked" Content="{loc:T settings.tab.general}" />
                <RadioButton Style="{StaticResource Tab.Pill}" GroupName="settingsTab" Tag="audio" Checked="Tab_Checked" Content="{loc:T settings.tab.audio}" />
                <RadioButton Style="{StaticResource Tab.Pill}" GroupName="settingsTab" Tag="sounds" Checked="Tab_Checked" Content="{loc:T settings.tab.sounds}" />
                <RadioButton Style="{StaticResource Tab.Pill}" GroupName="settingsTab" Tag="mini" Checked="Tab_Checked" Content="{loc:T settings.tab.mini}" />
                <RadioButton Style="{StaticResource Tab.Pill}" GroupName="settingsTab" Tag="advanced" Checked="Tab_Checked" Content="{loc:T settings.tab.advanced}" />
            </StackPanel>
        </Border>

        <!-- Personalización -->
        <StackPanel x:Name="PaneProfile" Tag="profile">
        <StackPanel Orientation="Horizontal" Margin="18,26,0,10"><TextBlock Text="&#xE77B;" Style="{StaticResource T.Icon}" FontSize="15" Foreground="{StaticResource B.AccentHi}" Margin="0,0,10,0" FlowDirection="LeftToRight" /><TextBlock Text="{loc:T settings.profile.section}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" /></StackPanel>
        <Border Style="{StaticResource Surface.Group}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="270" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T settings.profile.name.title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{loc:T settings.profile.name.hint}" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Style="{StaticResource Input.Flow}" Tag="{loc:T settings.profile.name.placeholder}" MaxLength="40" VerticalAlignment="Center"
                             Text="{Binding UserName, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="{loc:T settings.profile.name.title}" />
                </Grid>
                <Rectangle Style="{StaticResource Hairline}" />
                <Grid Style="{StaticResource Row}">
                    <StackPanel Margin="0,0,80,0">
                        <TextBlock Text="{loc:T settings.profile.welcome.title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{loc:T settings.profile.welcome.hint}" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding PersonalizedWelcome}" AutomationProperties.Name="{loc:T settings.profile.welcome.title}" />
                </Grid>
            </StackPanel>
        </Border>
        </StackPanel>

        <StackPanel x:Name="PaneGeneral" Tag="general" Visibility="Collapsed">

        <!-- Language -->
        <StackPanel Orientation="Horizontal" Margin="18,26,0,10"><TextBlock Text="&#xE774;" Style="{StaticResource T.Icon}" FontSize="15" Foreground="{StaticResource B.AccentHi}" Margin="0,0,10,0" FlowDirection="LeftToRight" /><TextBlock Text="{loc:T settings.language.section}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" /></StackPanel>
        <Border Style="{StaticResource Surface.Group}">
            <Grid Style="{StaticResource Row}">
                <StackPanel Margin="0,0,300,0">
                    <TextBlock Text="{loc:T settings.language.title}" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="{loc:T settings.language.hint}" Style="{StaticResource RowHint}" />
                </StackPanel>
                <ComboBox Style="{StaticResource Combo.Flow}" Width="270" HorizontalAlignment="Right" VerticalAlignment="Center" ItemsSource="{Binding LanguageChoices}"
                          SelectedValuePath="Code" SelectedValue="{Binding SelectedLanguageCode}" TextSearch.TextPath="Display" AutomationProperties.Name="{loc:T settings.language.title}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Display}" /></DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>
        </Border>

        <!-- General -->
        <StackPanel Orientation="Horizontal" Margin="18,26,0,10"><TextBlock Text="&#xE713;" Style="{StaticResource T.Icon}" FontSize="15" Foreground="{StaticResource B.AccentHi}" Margin="0,0,10,0" FlowDirection="LeftToRight" /><TextBlock Text="{loc:T settings.general.section}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" /></StackPanel>
        <Border Style="{StaticResource Surface.Group}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <StackPanel Margin="0,0,80,0">
                        <TextBlock Text="{loc:T settings.general.startWithWindows.title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{loc:T settings.general.startWithWindows.hint}" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding StartWithWindows}" AutomationProperties.Name="{loc:T settings.general.startWithWindows.title}" />
                </Grid>
                <Rectangle Style="{StaticResource Hairline}" />
                <Grid Style="{StaticResource Row}">
                    <StackPanel Margin="0,0,300,0">
                        <TextBlock Text="{loc:T settings.general.closeAction.title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{loc:T settings.general.closeAction.hint}" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <ComboBox Style="{StaticResource Combo.Flow}" Width="270" HorizontalAlignment="Right" VerticalAlignment="Center" ItemsSource="{Binding CloseActions}"
                              SelectedValuePath="Key" SelectedValue="{Binding CloseAction}" AutomationProperties.Name="{loc:T settings.general.closeAction.title}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <Rectangle Style="{StaticResource Hairline}" />
                <Grid Style="{StaticResource Row}">
                    <StackPanel Margin="0,0,80,0">
                        <TextBlock Text="{loc:T settings.general.resume.title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{loc:T settings.general.resume.hint}" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ResumeOnLaunch}" AutomationProperties.Name="{loc:T settings.general.resume.a11y}" />
                </Grid>
            </StackPanel>
        </Border>

        </StackPanel>
        <StackPanel x:Name="PaneAudio" Tag="audio" Visibility="Collapsed">
        <!-- Audio -->
        <StackPanel Orientation="Horizontal" Margin="18,26,0,10"><TextBlock Text="&#xE767;" Style="{StaticResource T.Icon}" FontSize="15" Foreground="{StaticResource B.AccentHi}" Margin="0,0,10,0" FlowDirection="LeftToRight" /><TextBlock Text="{loc:T settings.audio.section}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" /></StackPanel>
        <Border Style="{StaticResource Surface.Group}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <StackPanel Margin="0,0,80,0">
                        <TextBlock Text="{loc:T settings.audio.muteLocal.title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHint}"
                                   Text="{loc:T settings.audio.muteLocal.hint}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding MuteLocal}" IsEnabled="{Binding CanEditOptions}" AutomationProperties.Name="{loc:T settings.audio.muteLocal.a11y}" />
                </Grid>
                <Rectangle Style="{StaticResource Hairline}" />
                <Grid Style="{StaticResource Row}">
                    <StackPanel Margin="0,0,280,0">
                        <TextBlock Text="{loc:T settings.audio.prebuffer.title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHint}"
                                   Text="{loc:T settings.audio.prebuffer.hint}" />
                    </StackPanel>
                    <ComboBox Style="{StaticResource Combo.Flow}" Width="250" HorizontalAlignment="Right" VerticalAlignment="Center"
                              ItemsSource="{Binding PrebufferChoices}" SelectedValuePath="Key" SelectedValue="{Binding PrebufferKey}"
                              IsEnabled="{Binding CanEditOptions}" AutomationProperties.Name="{loc:T settings.audio.prebuffer.title}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <Rectangle Style="{StaticResource Hairline}" />
                <Grid Style="{StaticResource Row}">
                    <StackPanel Margin="0,0,80,0">
                        <TextBlock Text="{loc:T settings.audio.fullLevel.title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHint}"
                                   Text="{loc:T settings.audio.fullLevel.hint}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding FullLevel}" IsEnabled="{Binding FullLevelEnabled}" AutomationProperties.Name="{loc:T settings.audio.fullLevel.title}" />
                </Grid>
            </StackPanel>
        </Border>

        </StackPanel>
        <StackPanel x:Name="PaneSounds" Tag="sounds" Visibility="Collapsed">
        <!-- Sounds: "Audiora Enchanted" -->
        <StackPanel Orientation="Horizontal" Margin="18,26,0,10"><TextBlock Text="&#xE8D6;" Style="{StaticResource T.Icon}" FontSize="15" Foreground="{StaticResource B.AccentHi}" Margin="0,0,10,0" FlowDirection="LeftToRight" /><TextBlock Text="{loc:T settings.sounds.section}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" /></StackPanel>
        <Border Style="{StaticResource Surface.Group}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <StackPanel Margin="0,0,80,0">
                        <TextBlock Text="{loc:T settings.sounds.interface.title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:T settings.sounds.interface.hint}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding InterfaceSounds}" AutomationProperties.Name="{loc:T settings.sounds.interface.title}" />
                </Grid>
                <Rectangle Style="{StaticResource Hairline}" />
                <Grid Style="{StaticResource Row}">
                    <StackPanel Margin="0,0,80,0">
                        <TextBlock Text="{loc:T settings.sounds.notification.title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:T settings.sounds.notification.hint}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding NotificationSounds}" AutomationProperties.Name="{loc:T settings.sounds.notification.title}" />
                </Grid>
                <Rectangle Style="{StaticResource Hairline}" />
                <Grid Style="{StaticResource Row}">
                    <StackPanel Margin="0,0,80,0">
                        <TextBlock Text="{loc:T settings.sounds.connection.title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:T settings.sounds.connection.hint}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ConnectionSounds}" AutomationProperties.Name="{loc:T settings.sounds.connection.title}" />
                </Grid>
                <Rectangle Style="{StaticResource Hairline}" />
                <Grid Style="{StaticResource Row}">
                    <StackPanel Margin="0,0,80,0">
                        <TextBlock Text="{loc:T settings.sounds.loss.title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:T settings.sounds.loss.hint}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ConnectionLossSounds}" AutomationProperties.Name="{loc:T settings.sounds.loss.title}" />
                </Grid>
                <Rectangle Style="{StaticResource Hairline}" />
                <Grid Style="{StaticResource Row}">
                    <StackPanel Margin="0,0,80,0">
                        <TextBlock Text="{loc:T settings.sounds.error.title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:T settings.sounds.error.hint}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding ErrorSounds}" AutomationProperties.Name="{loc:T settings.sounds.error.title}" />
                </Grid>
                <Rectangle Style="{StaticResource Hairline}" />
                <Grid Style="{StaticResource Row}">
                    <StackPanel Margin="0,0,260,0">
                        <TextBlock Text="{loc:T settings.sounds.volume.title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:T settings.sounds.volume.hint}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" FlowDirection="LeftToRight">
                        <Slider x:Name="SoundsVolumeSlider" Style="{StaticResource Slider.Flow}" Width="170" Minimum="0" Maximum="100" SmallChange="5" LargeChange="10"
                                Value="{Binding SoundsVolume, Mode=TwoWay}" AutomationProperties.Name="{loc:T settings.sounds.volume.title}" />
                        <TextBlock Text="{Binding SoundsVolumeText}" Style="{StaticResource T.Dim}" Width="48" TextAlignment="Right" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <Rectangle Style="{StaticResource Hairline}" />
                <Grid Style="{StaticResource Row}">
                    <StackPanel Margin="0,0,280,0">
                        <TextBlock Text="{loc:T settings.sounds.device.title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:T settings.sounds.device.hint}" />
                    </StackPanel>
                    <ComboBox Style="{StaticResource Combo.Flow}" Width="250" HorizontalAlignment="Right" VerticalAlignment="Top"
                              ItemsSource="{Binding SoundDevices}" SelectedValuePath="Key" SelectedValue="{Binding SoundsDeviceKey}"
                              AutomationProperties.Name="{loc:T settings.sounds.device.title}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <Rectangle Style="{StaticResource Hairline}" />
                <StackPanel Margin="0,13">
                    <TextBlock Text="{loc:T settings.sounds.preview.title}" Style="{StaticResource RowTitle}" />
                    <TextBlock Style="{StaticResource RowHint}" Text="{loc:T settings.sounds.preview.hint}" />
                    <WrapPanel Margin="0,12,0,0">
                        <Button Content="{loc:T settings.sounds.p.connected}" Command="{Binding PreviewSoundCommand}" CommandParameter="Connected" Style="{StaticResource Btn.Pill}" Margin="0,0,8,8" />
                        <Button Content="{loc:T settings.sounds.p.lost}" Command="{Binding PreviewSoundCommand}" CommandParameter="ConnectionLost" Style="{StaticResource Btn.Pill}" Margin="0,0,8,8" />
                        <Button Content="{loc:T settings.sounds.p.reconnected}" Command="{Binding PreviewSoundCommand}" CommandParameter="Reconnected" Style="{StaticResource Btn.Pill}" Margin="0,0,8,8" />
                        <Button Content="{loc:T settings.sounds.p.error}" Command="{Binding PreviewSoundCommand}" CommandParameter="Error" Style="{StaticResource Btn.Pill}" Margin="0,0,8,8" />
                        <Button Content="{loc:T settings.sounds.p.start}" Command="{Binding PreviewSoundCommand}" CommandParameter="StreamStart" Style="{StaticResource Btn.Pill}" Margin="0,0,8,8" />
                        <Button Content="{loc:T settings.sounds.p.stop}" Command="{Binding PreviewSoundCommand}" CommandParameter="StreamStop" Style="{StaticResource Btn.Pill}" Margin="0,0,8,8" />
                        <Button Content="{loc:T settings.sounds.p.config}" Command="{Binding PreviewSoundCommand}" CommandParameter="ConfigChanged" Style="{StaticResource Btn.Pill}" Margin="0,0,8,8" />
                        <Button Content="{loc:T settings.sounds.p.navigate}" Command="{Binding PreviewSoundCommand}" CommandParameter="Navigate" Style="{StaticResource Btn.Pill}" Margin="0,0,8,8" />
                        <Button Content="{loc:T settings.sounds.p.toggleOn}" Command="{Binding PreviewSoundCommand}" CommandParameter="ToggleOn" Style="{StaticResource Btn.Pill}" Margin="0,0,8,8" />
                        <Button Content="{loc:T settings.sounds.p.toggleOff}" Command="{Binding PreviewSoundCommand}" CommandParameter="ToggleOff" Style="{StaticResource Btn.Pill}" Margin="0,0,8,8" />
                    </WrapPanel>
                    <TextBlock Text="{Binding SoundsNote}" Style="{StaticResource RowHint}" Foreground="{StaticResource B.Warn}" Margin="0,4,0,0"
                               Visibility="{Binding HasSoundsNote, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <Rectangle Style="{StaticResource Hairline}" />
                <Grid Style="{StaticResource Row}">
                    <StackPanel Margin="0,0,150,0">
                        <TextBlock Text="{loc:T settings.sounds.reset.title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Style="{StaticResource RowHint}" Text="{loc:T settings.sounds.reset.hint}" />
                    </StackPanel>
                    <Button Content="{loc:T settings.sounds.reset.button}" Command="{Binding ResetSoundsCommand}" Style="{StaticResource Btn.Pill}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        </StackPanel>
        <StackPanel x:Name="PaneMini" Tag="mini" Visibility="Collapsed">
        <!-- Mini player and shortcuts -->
        <StackPanel Orientation="Horizontal" Margin="18,26,0,10"><TextBlock Text="&#xE8A7;" Style="{StaticResource T.Icon}" FontSize="15" Foreground="{StaticResource B.AccentHi}" Margin="0,0,10,0" FlowDirection="LeftToRight" /><TextBlock Text="{loc:T settings.mini.section}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" /></StackPanel>
        <Border Style="{StaticResource Surface.Group}">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <StackPanel Margin="0,0,80,0">
                        <TextBlock Text="{loc:T settings.mini.show.title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{loc:T settings.mini.show.hint}" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding MiniVisible}" AutomationProperties.Name="{loc:T settings.mini.show.title}" />
                </Grid>
                <Rectangle Style="{StaticResource Hairline}" />
                <Grid Style="{StaticResource Row}">
                    <StackPanel Margin="0,0,80,0">
                        <TextBlock Text="{loc:T settings.mini.topmost.title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{loc:T settings.mini.topmost.hint}" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding MiniTopmost}" AutomationProperties.Name="{loc:T settings.mini.topmost.a11y}" />
                </Grid>
                <Rectangle Style="{StaticResource Hairline}" />
                <Grid Style="{StaticResource Row}">
                    <StackPanel Margin="0,0,80,0">
                        <TextBlock Text="{loc:T settings.mini.rememberPosition.title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{loc:T settings.mini.rememberPosition.hint}" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding MiniRememberPosition}" AutomationProperties.Name="{loc:T settings.mini.rememberPosition.a11y}" />
                </Grid>
                <Rectangle Style="{StaticResource Hairline}" />
                <Grid Style="{StaticResource Row}">
                    <StackPanel Margin="0,0,80,0">
                        <TextBlock Text="{loc:T settings.mini.minimizeToMini.title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{loc:T settings.mini.minimizeToMini.hint}" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding MinimizeToMini}" AutomationProperties.Name="{loc:T settings.mini.minimizeToMini.a11y}" />
                </Grid>
                <Rectangle Style="{StaticResource Hairline}" />
                <Grid Style="{StaticResource Row}">
                    <StackPanel Margin="0,0,80,0">
                        <TextBlock Text="{loc:T settings.mini.dimWhenIdle.title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{loc:T settings.mini.dimWhenIdle.hint}" Style="{StaticResource RowHint}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding MiniDimWhenIdle}" AutomationProperties.Name="{loc:T settings.mini.dimWhenIdle.a11y}" />
                </Grid>
                <Rectangle Style="{StaticResource Hairline}" />
                <Grid Style="{StaticResource Row}">
                    <StackPanel Margin="0,0,80,0">
                        <TextBlock Text="{loc:T settings.mini.hotkeys.title}" Style="{StaticResource RowTitle}" />
                        <TextBlock Text="{Binding HotkeysHelp}" Style="{StaticResource RowHint}" />
                        <TextBlock Text="{Binding HotkeysStatus}" Foreground="{StaticResource B.Warn}" FontSize="12" TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left" Margin="0,4,0,0"
                                   Visibility="{Binding HasHotkeysProblem, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource Switch}" HorizontalAlignment="Right" VerticalAlignment="Center" IsChecked="{Binding HotkeysEnabled}" AutomationProperties.Name="{loc:T settings.mini.hotkeys.title}" />
                </Grid>
            </StackPanel>
        </Border>

        </StackPanel>
        <StackPanel x:Name="PaneAdvanced" Tag="advanced" Visibility="Collapsed">
        <!-- Diagnostics -->
        <StackPanel Orientation="Horizontal" Margin="18,26,0,10"><TextBlock Text="&#xE9D9;" Style="{StaticResource T.Icon}" FontSize="15" Foreground="{StaticResource B.AccentHi}" Margin="0,0,10,0" FlowDirection="LeftToRight" /><TextBlock Text="{loc:T settings.diagnostics.section}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" /></StackPanel>
        <Border Style="{StaticResource Surface.Group}">
            <Grid Style="{StaticResource Row}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" MinWidth="160" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:T settings.diagnostics.logs.title}" Style="{StaticResource RowTitle}" />
                    <TextBlock Text="{Binding LogsPath}" Style="{StaticResource RowHint}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="1" Content="{loc:T settings.diagnostics.logs.open}" Command="{Binding OpenLogsCommand}" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource Btn.Pill}" Margin="12,0,0,0" />
            </Grid>
        </Border>

        <!-- Advanced: project source backups (a developer tool) -->
        <StackPanel Orientation="Horizontal" Margin="18,26,0,10"><TextBlock Text="&#xE8F1;" Style="{StaticResource T.Icon}" FontSize="15" Foreground="{StaticResource B.AccentHi}" Margin="0,0,10,0" FlowDirection="LeftToRight" /><TextBlock Text="{loc:T settings.backup.section}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" /></StackPanel>
        <Border Style="{StaticResource Surface.Group}" Padding="18,14" DataContext="{Binding Backups}">
            <StackPanel>
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MinWidth="280" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowHint}" Margin="0" VerticalAlignment="Center"
                               Text="{loc:T settings.backup.hint}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                        <Button Content="{loc:T settings.backup.openFolder}" Command="{Binding OpenFolderCommand}" Style="{StaticResource Btn.Pill}" Margin="0,0,8,0" />
                        <Button Content="{loc:T settings.backup.create}" Command="{Binding CreateCommand}" Style="{StaticResource Btn.Pill}" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,10,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="90" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="26" />
                        <RowDefinition Height="26" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{loc:T settings.backup.project}" Style="{StaticResource T.Dim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Column="1" Text="{Binding ProjectText}" Style="{StaticResource T.Base}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Content="{loc:T settings.backup.changeProject}" Command="{Binding ChooseProjectCommand}" Style="{StaticResource Btn.Quiet}" />
                    <TextBlock Grid.Row="1" Text="{loc:T settings.backup.location}" Style="{StaticResource T.Dim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding BackupRoot}" Style="{StaticResource T.Base}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                         MaxHeight="200" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="{loc:T settings.backup.list.a11y}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource B.Text}" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="9" Padding="10,7" Background="Transparent">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.Glass}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource B.GlassHi}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BackupRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DateText}" Style="{StaticResource T.Base}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Details}" Style="{StaticResource T.Dim}" FontSize="11" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0">
                                    <TextBlock Text="{Binding Reason}" Style="{StaticResource T.Base}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Id}" Style="{StaticResource T.Dim}" FontSize="11" FontFamily="Cascadia Mono, Consolas" />
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource T.Dim}" FontSize="11.5" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" MinWidth="220" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource T.Dim}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12,0,0,0">
                        <Button Content="{loc:T settings.backup.verify}" Command="{Binding VerifyCommand}" Style="{StaticResource Btn.Pill}" Margin="0,0,8,0" />
                        <Button Content="{loc:T settings.backup.restore}" Command="{Binding RestoreCommand}" Style="{StaticResource Btn.Pill}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>

        </StackPanel>

        <!-- About -->
        <StackPanel Orientation="Horizontal" Margin="18,30,0,0">
            <Image Source="{StaticResource Img.Logo}" Width="32" Height="32" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Audiora" Style="{StaticResource T.Base}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Version}" Style="{StaticResource T.Dim}" FontSize="12" />
            </StackPanel>
        </StackPanel>
        <TextBlock Style="{StaticResource T.Dim}" FontSize="12" TextWrapping="Wrap" LineHeight="19" Margin="18,10,0,0"
            ><Run Text="{loc:T settings.about.description}" /><LineBreak
            /><Run Text="{loc:T settings.about.thirdParty}" /><LineBreak
            /><Run Text="{loc:T settings.about.disclaimer}" /></TextBlock>
    </StackPanel>
</UserControl>
