<Window x:Class="SonosFlow.App.Views.NameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SonosFlow.App.Localization"
        Title="Audiora" Width="520" Height="490" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="{StaticResource F.Text}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}">

    <!-- First launch, after the language: "What should we call you?". Optional: skipping never blocks anything. -->
    <Border Background="{StaticResource B.Sheet}" BorderBrush="{StaticResource B.PanelEdge}" BorderThickness="1" CornerRadius="24" Margin="14"
            MouseLeftButtonDown="Root_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.6" Color="#000000" />
        </Border.Effect>
        <Grid Margin="32,26,32,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button Style="{StaticResource Btn.Quiet}" Content="&#xE8BB;" FontFamily="{StaticResource F.Icons}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,-10,-16,0" Click="Skip_Click" ToolTip="{loc:T onboarding.name.skip}" AutomationProperties.Name="{loc:T onboarding.name.skip}" IsTabStop="False" />

            <StackPanel>
                <Image Source="{StaticResource Img.Logo}" Width="56" Height="56" HorizontalAlignment="Left" />
                <TextBlock Text="{loc:T onboarding.title}" Style="{StaticResource T.Title}" FontSize="28" Margin="0,18,0,0" TextWrapping="Wrap" />
                <TextBlock Text="{loc:T onboarding.name.question}" Style="{StaticResource T.Section}" FontSize="16" Margin="0,30,0,10" TextWrapping="Wrap" />
                <TextBox x:Name="NameBox" Style="{StaticResource Input.Flow}" MaxLength="40" Height="50" Tag="{loc:T onboarding.name.placeholder}"
                         AutomationProperties.Name="{loc:T onboarding.name.question}" />
                <TextBlock Text="{loc:T onboarding.name.hint}" Style="{StaticResource T.Dim}" FontSize="12.5" TextWrapping="Wrap" Margin="2,10,0,0" LineHeight="18" />
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Btn.Quiet}" Padding="16,10" FontSize="13.5" Margin="0,0,8,0" Click="Skip_Click" IsCancel="True"
                        AutomationProperties.Name="{loc:T onboarding.name.skip}">
                    <TextBlock Text="{loc:T onboarding.name.skip}" />
                </Button>
                <Button x:Name="Confirm" Style="{StaticResource Btn.Accent}" Padding="22,10" FontSize="13.5" Click="Confirm_Click" IsDefault="True"
                        AutomationProperties.Name="{loc:T onboarding.confirm}">
                    <TextBlock Text="{loc:T onboarding.confirm}" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
