<Window x:Class="SonosFlow.App.Views.WelcomeBackWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:SonosFlow.App.Localization"
        Title="Audiora" Width="520" Height="330" WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False"
        FontFamily="{StaticResource F.Text}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        FlowDirection="{Binding FlowDirection, Source={x:Static loc:Loc.Instance}}"
        MouseLeftButtonDown="Dismiss" KeyDown="Dismiss_Key">

    <!-- Next launches: a short greeting by name on the way to the main window. Click or any key skips it. -->
    <Border x:Name="Card" Background="{StaticResource B.Sheet}" BorderBrush="{StaticResource B.PanelEdge}" BorderThickness="1" CornerRadius="24" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="8" Direction="270" Opacity="0.6" Color="#000000" />
        </Border.Effect>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="32,0">
            <Image Source="{StaticResource Img.Logo}" Width="64" Height="64" HorizontalAlignment="Center" />
            <TextBlock x:Name="Greeting" Style="{StaticResource T.Title}" FontSize="30" Margin="0,22,0,0" TextAlignment="Center" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{loc:T onboarding.back.subtitle}" Style="{StaticResource T.Dim}" FontSize="15" Margin="0,8,0,0" TextAlignment="Center" />
            <Border Width="120" Height="3" CornerRadius="2" Margin="0,26,0,0" Background="{StaticResource B.AccentGradient}" Opacity="0.85" />
        </StackPanel>
    </Border>
</Window>
