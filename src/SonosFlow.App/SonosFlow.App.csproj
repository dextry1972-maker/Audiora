<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>SonosFlow</AssemblyName>
    <RootNamespace>SonosFlow.App</RootNamespace>
    <ApplicationIcon>Assets\SonosFlow.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>Audiora</Product>
    <AssemblyTitle>Audiora</AssemblyTitle>
    <Description>Transmite el audio del PC a un altavoz Sonos por Wi-Fi.</Description>
    <Copyright>Proyecto personal. No afiliado a Sonos, Inc.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms is only used for the tray icon; keep its names out of the WPF code. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SonosFlow.Core\SonosFlow.Core.csproj" />
    <ProjectReference Include="..\SonosFlow.Backup\SonosFlow.Backup.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\SonosFlow.png" />
    <Resource Include="Assets\SonosFlow.ico" />
  </ItemGroup>

</Project>
